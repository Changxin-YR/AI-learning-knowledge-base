SQLITE_PATH=data/knowflow.db
APP_ENV=development
APP_VERSION=1.1.0
JWT_SECRET=replace-with-a-32-byte-secret
ACCESS_TOKEN_MINUTES=60
DEMO_AI_MODE=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Demo mode keeps the deterministic cited excerpt for /chat. Set DEMO_AI_MODE=0 to let the
# configured provider generate the answer strictly from the retrieved passages.
CHAT_TIMEOUT_SECONDS=60

RAG_MODE=hybrid
# Runtime quality modes:
# - basic: existing Hybrid semantic confidence gate only (default, no external cost)
# - rerank: semantic gate + optional Cross-Encoder ordering
# - verified: broad RRF candidates -> optional Cross-Encoder ordering -> strict evidence verifier
RAG_QUALITY_MODE=basic
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowflow_chunks
QDRANT_TIMEOUT_SECONDS=10
# Retries are for transient transport/startup failures only. Set to 0 to disable.
QDRANT_RETRY_COUNT=1
QDRANT_RETRY_BACKOFF_SECONDS=0.5
# Calibrated on the tuning set (eval_dataset) with the neural MiniLM provider: 0.25 keeps
# Recall@3 at 1.0000 without raising the no-answer false-citation rate versus 0.35.
VECTOR_SCORE_THRESHOLD=0.25

# Hybrid confidence gate:
# - auto: enabled for non-deterministic embedding providers, disabled for local hash vectors.
# - true/false: explicitly force the gate on or off.
# This remains the lightweight fallback gate when neural quality services are unavailable.
HYBRID_CONFIDENCE_GATE=auto
HYBRID_STRONG_VECTOR_THRESHOLD=0.415
HYBRID_AGREEMENT_TOP_K=2

# Optional Cross-Encoder reranker.
# IMPORTANT: the reranker is a relevance/order signal, not an answerability guarantee.
RERANK_PROVIDER=none
RERANK_BASE_URL=http://127.0.0.1:8002
RERANK_API_KEY=
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_SCORE_THRESHOLD=0.0
RERANK_CANDIDATE_LIMIT=8
RERANK_TIMEOUT_SECONDS=120

# Optional strict evidence-sufficiency verifier.
# Point these at an OpenAI-compatible chat provider (for example DeepSeek).
# The verifier uses only supplied passages and rejects topic overlap when the requested
# fact is absent. Keep credentials in .env only; never commit real keys.
ANSWERABILITY_BASE_URL=
ANSWERABILITY_API_KEY=
ANSWERABILITY_MODEL=
ANSWERABILITY_CANDIDATE_LIMIT=4
ANSWERABILITY_TIMEOUT_SECONDS=30
# DeepSeek defaults these on automatically when its base URL is detected. They are
# exposed here so deployments can make the behavior explicit.
ANSWERABILITY_DISABLE_THINKING=true
ANSWERABILITY_JSON_OUTPUT=true

# Embedding modes:
# - local: deterministic offline vectorizer used by the default test suite.
# - openai: any OpenAI-compatible /embeddings endpoint, including the optional
#   local neural service in server/neural_embedding_service.py.
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
# Local neural models can take longer on their first request while weights are loaded.
# Runtime mode defaults to 120 seconds and one retry so cold-start indexing does not
# collapse into an unexplained vector_indexed=false result after a transient timeout.
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_RETRY_COUNT=1
EMBEDDING_RETRY_BACKOFF_SECONDS=1.0

# Optional local neural retrieval service. Install server/requirements-neural.txt
# and start server/neural_embedding_service.py separately. The default multilingual
# MiniLM embedding model produces 384 dims, so use a separate Qdrant collection such
# as knowflow_chunks_neural_384. The same service also exposes /rerank with the
# multilingual MMARCO Cross-Encoder configured below.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LOCAL_RERANK_DEVICE=cpu
LOCAL_EMBEDDING_API_KEY=

REPOSITORY_CLONE_TIMEOUT_SECONDS=30
REPOSITORY_MAX_FILES=2000
REPOSITORY_MAX_FILE_BYTES=1048576
REPOSITORY_MAX_TOTAL_BYTES=52428800
