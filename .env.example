SQLITE_PATH=data/knowflow.db
APP_ENV=development
JWT_SECRET=replace-with-a-32-byte-secret
ACCESS_TOKEN_MINUTES=60
DEMO_AI_MODE=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

RAG_MODE=hybrid
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowflow_chunks
VECTOR_SCORE_THRESHOLD=0.35

# Hybrid confidence gate:
# - auto: enabled for non-deterministic embedding providers, disabled for local hash vectors.
# - true/false: explicitly force the gate on or off.
# The gate keeps RRF ranking benefits but only emits semantically supported citations.
HYBRID_CONFIDENCE_GATE=auto
HYBRID_STRONG_VECTOR_THRESHOLD=0.415
HYBRID_AGREEMENT_TOP_K=2

# Embedding modes:
# - local: deterministic offline vectorizer used by the default test suite.
# - openai: any OpenAI-compatible /embeddings endpoint, including the optional
#   local neural service in server/neural_embedding_service.py.
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256

# Optional local neural embedding service. Install server/requirements-neural.txt
# and start it separately. The default multilingual MiniLM model produces 384 dims,
# so use a separate Qdrant collection such as knowflow_chunks_neural_384.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_API_KEY=

REPOSITORY_CLONE_TIMEOUT_SECONDS=30
REPOSITORY_MAX_FILES=2000
REPOSITORY_MAX_FILE_BYTES=1048576
REPOSITORY_MAX_TOTAL_BYTES=52428800
